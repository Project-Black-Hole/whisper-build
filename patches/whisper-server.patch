+// [pbh] This server answers one program only, the app that started it: the
+// app passes a random token through the environment and sends it back with
+// every request.
+const char * const PBH_TOKEN_ENV = "PBH_WHISPER_TOKEN";
+const size_t PBH_TOKEN_MIN = 32;
+
+// [pbh] Compares every byte, whatever the strings hold.
+bool pbh_same(const std::string & a, const std::string & b) {
+    if (a.size() != b.size()) {
+        return false;
+    }
+    unsigned char diff = 0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        diff |= static_cast<unsigned char>(a[i]) ^ static_cast<unsigned char>(b[i]);
+    }
+    return diff == 0;
+}
